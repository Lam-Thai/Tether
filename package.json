{
  "name": "tether",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n web,api -c blue,green \"pnpm --filter web dev\" \"uv run --directory apps/api uvicorn main:app --reload\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
